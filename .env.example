# =====================================================================
#  Cấu hình dùng chung cho toàn bộ hệ thống. KHÔNG commit file này.
#  Mẫu: .env.example
#  Quy ước (dev/demo): mật khẩu = tên tài khoản cho dễ theo dõi
# =====================================================================

# ===== Docker =====
# UID/GID của user trên máy (lệnh: id -u / id -g) — để Mosquitto ghi được data/log
HOST_UID=1000
HOST_GID=1000

# ===== PostgreSQL (Docker, có pgvector) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=warehouse
# Tài khoản quản trị (dùng cho pgAdmin)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
# Java BE — sở hữu schema "app"
POSTGRES_BACKEND_USER=backend
POSTGRES_BACKEND_PASSWORD=backend
# AI Agent — sở hữu schema "agent" (không đọc được schema "app")
POSTGRES_AGENT_USER=agent
POSTGRES_AGENT_PASSWORD=agent

# ===== pgAdmin =====
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin@example.com

# ===== MQTT broker (Mosquitto) =====
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001
# Tài khoản cho công cụ dev (tools/push_config.py, mosquitto_sub/pub)
MQTT_USER=admin
MQTT_PASSWORD=admin
# Tài khoản riêng cho từng service
MQTT_ESP32_USER=esp32
MQTT_ESP32_PASSWORD=esp32
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=backend
MQTT_AGENT_USER=agent
MQTT_AGENT_PASSWORD=agent

# ===== Ngưỡng cảnh báo (gửi xuống ESP32 bằng: python tools/push_config.py) =====
# MQ2: giá trị ADC thô 0..4095, MQ2_DANGER phải lớn hơn MQ2_WARNING
MQ2_WARNING=1500
MQ2_DANGER=2500
# Nhiệt độ (°C) và độ ẩm (%)
TEMP_HIGH=38
HUM_HIGH=80

# ===== OpenAI =====
OPENAI_API_KEY=
# Model chat / STT / TTS: chọn ở giai đoạn 4
OPENAI_MODEL=
OPENAI_MODEL_WORKER=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_STT_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# ===== LangSmith (tùy chọn, TẮT mặc định — gửi dữ liệu ra dịch vụ ngoài) =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
