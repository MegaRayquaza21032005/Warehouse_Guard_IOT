# =====================================================================
#  Cấu hình dùng chung cho toàn bộ hệ thống. KHÔNG commit file này.
#  Mẫu: .env.example
#  Quy ước (dev/demo): mật khẩu = tên tài khoản cho dễ theo dõi
# =====================================================================

# ===== Docker =====
# UID/GID của user trên máy (lệnh: id -u / id -g) — để Mosquitto ghi được data/log
HOST_UID=1000
HOST_GID=1000

# ===== PostgreSQL (Docker, có pgvector) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=warehouse
# Tài khoản quản trị (dùng cho pgAdmin)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
# Java BE — sở hữu schema "app"
POSTGRES_BACKEND_USER=backend
POSTGRES_BACKEND_PASSWORD=backend
# AI Agent — sở hữu schema "agent" (không đọc được schema "app")
POSTGRES_AGENT_USER=agent
POSTGRES_AGENT_PASSWORD=agent

# ===== pgAdmin =====
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin@example.com

# ===== MQTT broker (Mosquitto) =====
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001
# Tài khoản cho công cụ dev (tools/push_config.py, mosquitto_sub/pub)
MQTT_USER=admin
MQTT_PASSWORD=admin
# Tài khoản riêng cho từng service
MQTT_ESP32_USER=esp32
MQTT_ESP32_PASSWORD=esp32
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=backend
MQTT_AGENT_USER=agent
MQTT_AGENT_PASSWORD=agent

# ===== Java BE =====
BACKEND_PORT=8080
# Khóa ký JWT (HS256, >= 32 byte). Đổi khóa => mọi phiên đăng nhập hết hiệu lực.
JWT_SECRET=change-me-to-64-hex-chars
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=30
# AI Agent gọi API Java BE bằng header X-Internal-Key
INTERNAL_API_KEY=ai-agent
# Giờ làm việc (dùng cho thống kê trong / ngoài giờ và phát hiện đột nhập). WORK_DAYS: 1=Thứ 2 ... 7=Chủ nhật
WORK_HOURS_START=08:00
WORK_HOURS_END=17:30
WORK_DAYS=1,2,3,4,5,6
# Origin được phép gọi API (web dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081
# Push notification FCM (app mobile): đường dẫn file JSON service account của Firebase
# (Firebase console → Project settings → Service accounts → Generate new private key). Để trống = tắt push.
# Đặt file trong thư mục secrets/ (đã .gitignore), vd. FCM_CREDENTIALS_FILE=../secrets/firebase-service-account.json
FCM_CREDENTIALS_FILE=

# ===== Ngưỡng cảnh báo (gửi xuống ESP32 bằng: python tools/push_config.py) =====
# MQ135: giá trị ADC thô 0..4095, MQ135_DANGER phải lớn hơn MQ135_WARNING
MQ135_WARNING=1500
MQ135_DANGER=2500
# Nhiệt độ (°C) và độ ẩm (%) cao
TEMP_HIGH=38
HUM_HIGH=80
# Nghi cháy khi nhiệt độ tăng >= TEMP_RISE_C (°C) trong TEMP_RISE_WINDOW_MIN phút (1-15)
TEMP_RISE_C=3
TEMP_RISE_WINDOW_MIN=5
# Phun sương: tối đa khi cháy / mỗi lần làm mát / nghỉ giữa 2 lần (phút); chỉ làm mát khi ẩm < MIST_HUM_MAX (%)
MIST_FIRE_MAX_MIN=10
MIST_COOL_MAX_MIN=5
MIST_COOLDOWN_MIN=15
MIST_HUM_MAX=70
# Thông gió không hiệu quả: quạt chạy vì ẩm HUM_FAN_CHECK_MIN phút mà ẩm giảm < HUM_FAN_MIN_DROP (%)
HUM_FAN_CHECK_MIN=30
HUM_FAN_MIN_DROP=3

# ===== Ngưỡng chỉ dùng ở AI Agent (giai đoạn 3) — KHÔNG gửi xuống ESP32 =====
CMD_ACK_TIMEOUT_S=10
ESCALATION_MIN=5
LLM_ALERT_TIMEOUT_S=15

# ===== AI Agent — tầng luật (giai đoạn 3) =====
AGENT_PORT=8000
# Log ra terminal: LOG_LEVEL=DEBUG để thấy từng bản tin MQTT; LOG_FORMAT=json để xuất JSON
LOG_LEVEL=INFO
LOG_FORMAT=text
# Không nhận dữ liệu cảm biến quá N giây => coi như mất kết nối (ESP32 gửi 5s/lần)
OFFLINE_TIMEOUT_S=60
# Cảnh báo info / warning cùng loại không gửi lại trong N phút (critical không bao giờ bị chặn)
ALERT_COOLDOWN_MIN=10
# Trạng thái "gas" phải giữ N giây mới cảnh báo (chống báo giả); gas_danger / fire báo ngay
GAS_CONFIRM_S=10
# Nóng / ẩm vượt ngưỡng liên tục N phút => cảnh báo info
ENV_PROLONGED_MIN=15
# Chuyển động ngoài giờ: bật đèn N giây; hết chuyển động N phút => đóng sự cố đột nhập
LIGHT_ON_AFTER_HOURS_S=300
INTRUSION_CLEAR_MIN=10

# ===== OpenAI =====
OPENAI_API_KEY=
# Supervisor dùng OPENAI_MODEL; worker dùng OPENAI_MODEL_WORKER (trống = như OPENAI_MODEL)
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MODEL_WORKER=
# none = nhanh (~1s/lượt), tool chạy qua chat completions; low/medium/high -> tự chuyển Responses API, chậm hơn
OPENAI_REASONING_EFFORT=none
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# STT / TTS phía server — chỉ dùng khi thiết bị không nhận dạng / đọc được tiếng Việt
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TIMEOUT_S=30

# ===== AI Agent — multi-agent + chatbot (giai đoạn 4) =====
# Luồng sự cố dùng LLM viết nội dung cảnh báo (false = chỉ tầng luật)
INCIDENT_LLM_ENABLED=true
# Giới hạn vòng lặp: số lượt Supervisor / số vòng tool mỗi worker / timeout worker / timeout cả yêu cầu chat
AGENT_MAX_STEPS=6
WORKER_MAX_STEPS=5
WORKER_TIMEOUT_S=45
CHAT_TIMEOUT_S=120
# Hội thoại dài hơn N tin -> tóm tắt phần cũ; giới hạn tin nhắn mỗi người dùng mỗi giờ
CHAT_HISTORY_MAX_MESSAGES=30
CHAT_MAX_PER_HOUR=60
# Đề xuất điều khiển chờ bấm [Đồng ý] quá N giây -> hết hạn (coi như Hủy)
CONFIRM_TTL_S=300

# ===== Long-term memory (giai đoạn 5) — PostgresStore + pgvector, embedding OPENAI_EMBEDDING_MODEL =====
# Số chiều embedding (text-embedding-3-large = 3072, lưu halfvec). Đổi model/số chiều -> phải embed lại toàn bộ
EMBEDDING_DIMS=3072
MEMORY_ENABLED=true
# Bước trích xuất memory chạy nền (sau lượt chat: sở thích cá nhân; khi đóng sự cố: tóm tắt sự cố)
MEMORY_EXTRACT_ENABLED=true
# Số mục kiến thức kho nạp vào ngữ cảnh mỗi lượt; độ giống tối thiểu (cosine) khi tìm; giống hơn mức trùng -> không lưu lại
MEMORY_CONTEXT_LIMIT=5
MEMORY_MIN_SCORE=0.4
MEMORY_DEDUPE_SCORE=0.8
# Dọn dữ liệu cũ: checkpoint hội thoại / sự cố (ngày), nhật ký tool đọc / tool ghi (ngày)
CHECKPOINT_TTL_DAYS=30
TOOL_LOG_READ_DAYS=90
TOOL_LOG_WRITE_DAYS=365

# ===== Langfuse — tracing LLM / agent =====
# LANGFUSE_HOST hoặc LANGFUSE_BASE_URL. Cloud: https://cloud.langfuse.com (EU) | https://jp.cloud.langfuse.com (JP) | https://us.cloud.langfuse.com (US) | hoặc URL tự host
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
