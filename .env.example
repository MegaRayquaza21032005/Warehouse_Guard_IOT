# =====================================================================
#  Cấu hình dùng chung cho toàn bộ hệ thống. KHÔNG commit file này.
#  Mẫu: .env.example
#  Quy ước (dev/demo): mật khẩu = tên tài khoản cho dễ theo dõi
# =====================================================================

# ===== Docker =====
# UID/GID của user trên máy (lệnh: id -u / id -g) — để Mosquitto ghi được data/log
HOST_UID=1000
HOST_GID=1000

# ===== PostgreSQL (Docker, có pgvector) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=warehouse
# Tài khoản quản trị (dùng cho pgAdmin)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
# Java BE — sở hữu schema "app"
POSTGRES_BACKEND_USER=backend
POSTGRES_BACKEND_PASSWORD=backend
# AI Agent — sở hữu schema "agent" (không đọc được schema "app")
POSTGRES_AGENT_USER=agent
POSTGRES_AGENT_PASSWORD=agent

# ===== pgAdmin =====
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin@example.com

# ===== MQTT broker (Mosquitto) =====
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001
# Tài khoản cho công cụ dev (tools/push_config.py, mosquitto_sub/pub)
MQTT_USER=admin
MQTT_PASSWORD=admin
# Tài khoản riêng cho từng service
MQTT_ESP32_USER=esp32
MQTT_ESP32_PASSWORD=esp32
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=backend
MQTT_AGENT_USER=agent
MQTT_AGENT_PASSWORD=agent

# ===== Java BE =====
BACKEND_PORT=8080
# Khóa ký JWT (HS256, >= 32 byte). Đổi khóa => mọi phiên đăng nhập hết hiệu lực.
JWT_SECRET=change-me-to-64-hex-chars
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=30
# AI Agent gọi API Java BE bằng header X-Internal-Key
INTERNAL_API_KEY=ai-agent
# Giờ làm việc (dùng cho thống kê trong / ngoài giờ và phát hiện đột nhập). WORK_DAYS: 1=Thứ 2 ... 7=Chủ nhật
WORK_HOURS_START=08:00
WORK_HOURS_END=17:30
WORK_DAYS=1,2,3,4,5,6
# Origin được phép gọi API (web dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# ===== Ngưỡng cảnh báo (gửi xuống ESP32 bằng: python tools/push_config.py) =====
# MQ2: giá trị ADC thô 0..4095, MQ2_DANGER phải lớn hơn MQ2_WARNING
MQ2_WARNING=1500
MQ2_DANGER=2500
# Nhiệt độ (°C) và độ ẩm (%) cao
TEMP_HIGH=38
HUM_HIGH=80
# Nghi cháy khi nhiệt độ tăng >= TEMP_RISE_C (°C) trong TEMP_RISE_WINDOW_MIN phút (1-15)
TEMP_RISE_C=3
TEMP_RISE_WINDOW_MIN=5
# Phun sương: tối đa khi cháy / mỗi lần làm mát / nghỉ giữa 2 lần (phút); chỉ làm mát khi ẩm < MIST_HUM_MAX (%)
MIST_FIRE_MAX_MIN=10
MIST_COOL_MAX_MIN=5
MIST_COOLDOWN_MIN=15
MIST_HUM_MAX=70
# Thông gió không hiệu quả: quạt chạy vì ẩm HUM_FAN_CHECK_MIN phút mà ẩm giảm < HUM_FAN_MIN_DROP (%)
HUM_FAN_CHECK_MIN=30
HUM_FAN_MIN_DROP=3

# ===== Ngưỡng chỉ dùng ở AI Agent (giai đoạn 3) — KHÔNG gửi xuống ESP32 =====
CMD_ACK_TIMEOUT_S=10
ESCALATION_MIN=5
LLM_ALERT_TIMEOUT_S=15


# ===== OpenAI =====
OPENAI_API_KEY=
# Model chat / STT / TTS: chọn ở giai đoạn 4
OPENAI_MODEL=
OPENAI_MODEL_WORKER=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_STT_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# ===== Langfuse — tracing LLM / agent (bật ở giai đoạn 3-4 khi có API key) =====
# Cloud: https://cloud.langfuse.com (EU) | https://us.cloud.langfuse.com (US) | hoặc URL tự host
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
